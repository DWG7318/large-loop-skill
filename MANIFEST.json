  "progress_rule": "D1 accepted CELL and D2 verified GO are separate versioned counts",
  "cell_capacity_rule": "DEVICE_CAPACITY_PROFILE plus cumulative load and PASS gate before dispatch",
  "completion_handoff": "LOOP_OWNER_ACCEPTED",
