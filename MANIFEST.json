  "graph_rule": "directed acyclic GO execution graph",
  "waiting_rule": "typed WAITING_GO reasons; no schedulable intermediate queue",
  "activation_rule": "maximum-cardinality maximal safe ACTIVE_GO set",
  "causal_rule": "current-source-bound, incident-selected trace with strict typed-seed source disposition and minimum downstream impact",
