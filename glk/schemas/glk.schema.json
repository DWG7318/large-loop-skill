{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DWG7318/large-loop-skill/glk/schemas/glk.schema.json",
  "title": "GLK 2.4.0 executable contracts",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "string_array": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "dependency_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source", "target", "justification",
        "source_claim_or_output_refs", "target_input_or_assumption_refs",
        "consumption_evidence_refs"
      ],
      "properties": {
        "source": {"$ref": "#/$defs/id"},
        "target": {"$ref": "#/$defs/id"},
        "justification": {"$ref": "#/$defs/id"},
        "source_claim_or_output_refs": {
          "$ref": "#/$defs/string_array", "minItems": 1
        },
        "target_input_or_assumption_refs": {
          "$ref": "#/$defs/string_array", "minItems": 1
        },
        "consumption_evidence_refs": {
          "$ref": "#/$defs/string_array", "minItems": 1
        }
      }
    },
    "causal_path_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source", "target", "justification",
        "source_claim_or_output_refs", "target_input_or_assumption_refs",
        "consumption_evidence_refs", "incident_evidence_refs",
        "confirmation_status"
      ],
      "properties": {
        "source": {"$ref": "#/$defs/id"},
        "target": {"$ref": "#/$defs/id"},
        "justification": {"$ref": "#/$defs/id"},
        "source_claim_or_output_refs": {
          "$ref": "#/$defs/string_array", "minItems": 1
        },
        "target_input_or_assumption_refs": {
          "$ref": "#/$defs/string_array", "minItems": 1
        },
        "consumption_evidence_refs": {
          "$ref": "#/$defs/string_array", "minItems": 1
        },
        "incident_evidence_refs": {
          "$ref": "#/$defs/string_array", "minItems": 1
        },
        "confirmation_status": {"enum": ["SUSPECTED", "CONFIRMED"]}
      }
    },
    "confirmed_causal_path_step": {
      "allOf": [
        {"$ref": "#/$defs/causal_path_step"},
        {"properties": {"confirmation_status": {"const": "CONFIRMED"}}}
      ]
    },
    "impact_seed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {"enum": ["CANDIDATE", "EVIDENCE", "CLAIM_OR_OUTPUT"]},
        "ref": {"$ref": "#/$defs/id"}
      }
    },
    "impact_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "go_id", "disposition", "invalidated_candidate_refs",
        "invalidated_receipt_refs", "evidence_refs"
      ],
      "properties": {
        "go_id": {"$ref": "#/$defs/id"},
        "disposition": {
          "enum": ["UNAFFECTED", "REVERIFY", "REWORK", "QUARANTINE"]
        },
        "invalidated_candidate_refs": {"$ref": "#/$defs/string_array"},
        "invalidated_receipt_refs": {"$ref": "#/$defs/string_array"},
        "evidence_refs": {"$ref": "#/$defs/string_array"}
      }
    },
    "role_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "role_binding_id", "role_type", "run_id",
        "instance_id", "context_id", "workspace_id", "evidence_root", "created_at"
      ],
      "properties": {
        "schema_version": {"const": "2.4.0"},
        "role_binding_id": {"$ref": "#/$defs/id"},
        "role_type": {
          "enum": [
            "RUN_SUPERVISOR", "WORKER", "CHECKER",
            "GO_VERIFIER", "RUN_VERIFIER", "OWNER"
          ]
        },
        "run_id": {"$ref": "#/$defs/id"},
        "go_id": {"type": ["string", "null"]},
        "instance_id": {"$ref": "#/$defs/id"},
        "context_id": {"$ref": "#/$defs/id"},
        "workspace_id": {"$ref": "#/$defs/id"},
        "evidence_root": {"$ref": "#/$defs/id"},
        "created_at": {"$ref": "#/$defs/id"}
      }
    },
    "waiting_reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "references", "evidence_ref"],
      "properties": {
        "type": {
          "enum": [
            "DEPENDENCY_UNMET", "WRITE_CONFLICT", "RESOURCE",
            "ISOLATION", "SAFETY"
          ]
        },
        "references": {"$ref": "#/$defs/string_array", "minItems": 1},
        "evidence_ref": {"$ref": "#/$defs/id"}
      }
    },
    "run_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "run_id", "feature_slice_id", "run_feature",
        "run_scope", "baselines", "ui_lock", "claims", "evidence_required",
        "autonomy_boundaries", "candidate_binding", "run_supervisor_binding",
        "supervisor_reuse_forbidden"
      ],
      "properties": {
        "schema_version": {"const": "2.4.0"},
        "run_id": {"$ref": "#/$defs/id"},
        "feature_slice_id": {"$ref": "#/$defs/id"},
        "run_feature": {"$ref": "#/$defs/id"},
        "run_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["included", "excluded"],
          "properties": {
            "included": {"$ref": "#/$defs/string_array"},
            "excluded": {"$ref": "#/$defs/string_array"}
          }
        },
        "baselines": {"$ref": "#/$defs/string_array"},
        "ui_lock": {"type": ["string", "null"]},
        "claims": {"$ref": "#/$defs/string_array"},
        "evidence_required": {"$ref": "#/$defs/string_array"},
        "autonomy_boundaries": {"$ref": "#/$defs/string_array"},
        "candidate_binding": {"$ref": "#/$defs/id"},
        "run_supervisor_binding": {
          "allOf": [
            {"$ref": "#/$defs/role_binding"},
            {"properties": {"role_type": {"const": "RUN_SUPERVISOR"}}}
          ]
        },
        "supervisor_reuse_forbidden": {"const": true}
      }
    },
    "go": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "go_id", "run_id", "graph_version", "title",
        "intent", "scope", "claim", "acceptance", "evidence_required",
        "predecessors", "conflict_keys", "graph_state", "execution_phase",
        "waiting_reasons", "candidate_binding"
      ],
      "properties": {
        "schema_version": {"const": "2.4.0"},
        "go_id": {"$ref": "#/$defs/id"},
        "run_id": {"$ref": "#/$defs/id"},
        "graph_version": {"type": "integer", "minimum": 1},
        "title": {"$ref": "#/$defs/id"},
        "intent": {"$ref": "#/$defs/id"},
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["included", "excluded"],
          "properties": {
            "included": {"$ref": "#/$defs/string_array"},
            "excluded": {"$ref": "#/$defs/string_array"}
          }
        },
        "claim": {"$ref": "#/$defs/id"},
        "acceptance": {"$ref": "#/$defs/string_array"},
        "evidence_required": {"$ref": "#/$defs/string_array"},
        "predecessors": {"$ref": "#/$defs/string_array"},
        "conflict_keys": {"$ref": "#/$defs/string_array"},
        "graph_state": {
          "enum": [
            "WAITING_GO", "ACTIVE_GO", "GO_VERIFIED", "GO_BLOCKED",
            "GO_REJECTED", "SUPERSEDED", "CANCELLED"
          ]
        },
        "execution_phase": {
          "type": ["string", "null"],
          "enum": [null, "IMPLEMENTING", "CHECKING", "VERIFYING", "REWORK"]
        },
        "waiting_reasons": {
          "type": "array",
          "items": {"$ref": "#/$defs/waiting_reason"}
        },
        "candidate_binding": {"type": ["string", "null"]}
      }
    },
    "graph_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "graph_id", "run_id", "version", "graph_hash",
        "nodes", "edges", "entry_go_ids", "terminal_go_ids",
        "run_feature_coverage", "acyclic", "waiting_go_ids", "active_go_ids",
        "frozen_at"
      ],
      "properties": {
        "schema_version": {"const": "2.4.0"},
        "graph_id": {"$ref": "#/$defs/id"},
        "run_id": {"$ref": "#/$defs/id"},
        "version": {"type": "integer", "minimum": 1},
        "graph_hash": {"$ref": "#/$defs/hash"},
        "nodes": {"$ref": "#/$defs/string_array"},
        "edges": {
          "type": "array",
          "items": {"$ref": "#/$defs/dependency_edge"}
        },
        "entry_go_ids": {"$ref": "#/$defs/string_array"},
        "terminal_go_ids": {"$ref": "#/$defs/string_array"},
        "run_feature_coverage": {"$ref": "#/$defs/string_array"},
        "acyclic": {"const": true},
        "waiting_go_ids": {"$ref": "#/$defs/string_array"},
        "active_go_ids": {"$ref": "#/$defs/string_array"},
        "frozen_at": {"$ref": "#/$defs/id"}
      }
    },
    "cell_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "cell_id", "go_id", "graph_version", "candidate_id", "candidate_sha256", "d0", "d1"],
      "properties": {
        "schema_version": {"const": "2.4.0"},
        "cell_id": {"$ref": "#/$defs/id"},
        "go_id": {"$ref": "#/$defs/id"},
        "graph_version": {"type": "integer", "minimum": 1},
        "candidate_id": {"$ref": "#/$defs/id"},
        "candidate_sha256": {"$ref": "#/$defs/hash"},
        "d0": {"$ref": "#/$defs/verdict_block"},
        "d1": {"$ref": "#/$defs/verdict_block"}
      }
    },
    "verdict_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "actor_binding_ref", "verdict", "evidence", "issued_at"],
      "properties": {
        "receipt_id": {"$ref": "#/$defs/id"},
        "actor_binding_ref": {"$ref": "#/$defs/id"},
        "verdict": {"$ref": "#/$defs/id"},
        "evidence": {"$ref": "#/$defs/string_array"},
        "issued_at": {"$ref": "#/$defs/id"}
      }
    },
    "go_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "go_id", "graph_version", "candidate_id", "candidate_sha256", "d2", "successor_release"],
      "properties": {
        "schema_version": {"const": "2.4.0"},
        "go_id": {"$ref": "#/$defs/id"},
        "graph_version": {"type": "integer", "minimum": 1},
        "candidate_id": {"$ref": "#/$defs/id"},
        "candidate_sha256": {"$ref": "#/$defs/hash"},
        "d2": {"$ref": "#/$defs/verification_block"},
        "successor_release": {"$ref": "#/$defs/string_array"}
      }
    },
    "run_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "graph_version", "candidate_id", "candidate_sha256", "d3"],
      "properties": {
        "schema_version": {"const": "2.4.0"},
        "run_id": {"$ref": "#/$defs/id"},
        "graph_version": {"type": "integer", "minimum": 1},
        "candidate_id": {"$ref": "#/$defs/id"},
        "candidate_sha256": {"$ref": "#/$defs/hash"},
        "d3": {"$ref": "#/$defs/verification_block"}
      }
    },
    "verification_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "verifier_binding_ref", "execution_context_ref", "verdict", "receipts_consumed", "claims_checked", "evidence", "issued_at"],
      "properties": {
        "receipt_id": {"$ref": "#/$defs/id"},
        "verifier_binding_ref": {"$ref": "#/$defs/id"},
        "execution_context_ref": {"$ref": "#/$defs/id"},
        "verdict": {"$ref": "#/$defs/id"},
        "receipts_consumed": {"$ref": "#/$defs/string_array"},
        "claims_checked": {"$ref": "#/$defs/string_array"},
        "evidence": {"$ref": "#/$defs/string_array"},
        "issued_at": {"$ref": "#/$defs/id"}
      }
    },
    "go_causal_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "trace_id", "incident_id", "graph_id",
        "graph_version", "observed_at_go", "source_go",
        "source_candidate_ref", "source_evidence_refs", "symptom_go_ids",
        "causal_path", "excluded_edges", "stopping_reason",
        "confirmation_status", "issued_at"
      ],
      "properties": {
        "schema_version": {"const": "2.4.0"},
        "trace_id": {"$ref": "#/$defs/id"},
        "incident_id": {"$ref": "#/$defs/id"},
        "graph_id": {"$ref": "#/$defs/id"},
        "graph_version": {"type": "integer", "minimum": 1},
        "observed_at_go": {"$ref": "#/$defs/id"},
        "source_go": {"$ref": "#/$defs/id"},
        "source_candidate_ref": {"$ref": "#/$defs/id"},
        "source_evidence_refs": {
          "$ref": "#/$defs/string_array", "minItems": 1
        },
        "symptom_go_ids": {"$ref": "#/$defs/string_array"},
        "causal_path": {
          "type": "array",
          "items": {"$ref": "#/$defs/causal_path_step"}
        },
        "excluded_edges": {
          "type": "array",
          "items": {"$ref": "#/$defs/dependency_edge"}
        },
        "stopping_reason": {"$ref": "#/$defs/id"},
        "confirmation_status": {"enum": ["SUSPECTED", "CONFIRMED"]},
        "issued_at": {"$ref": "#/$defs/id"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"confirmation_status": {"const": "CONFIRMED"}},
            "required": ["confirmation_status"]
          },
          "then": {
            "properties": {
              "causal_path": {
                "items": {"$ref": "#/$defs/confirmed_causal_path_step"}
              }
            }
          }
        }
      ]
    },
    "graph_amendment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "amendment_id", "graph_id", "from_version",
        "to_version", "reason", "causal_trace_ref", "causal_trace_status",
        "source_go", "source_disposition", "impact_seeds",
        "before", "after", "affected_claims",
        "active_work_impact", "impact_slice", "invalidated_evidence",
        "invalidated_receipts", "reactivation_projection", "rollback",
        "authority_binding_ref", "issued_at"
      ],
      "properties": {
        "schema_version": {"const": "2.4.0"},
        "amendment_id": {"$ref": "#/$defs/id"},
        "graph_id": {"$ref": "#/$defs/id"},
        "from_version": {"type": "integer", "minimum": 1},
        "to_version": {"type": "integer", "minimum": 2},
        "reason": {"$ref": "#/$defs/id"},
        "causal_trace_ref": {"$ref": "#/$defs/id"},
        "causal_trace_status": {"const": "CONFIRMED"},
        "source_go": {"$ref": "#/$defs/id"},
        "source_disposition": {"enum": ["REVERIFY", "REWORK", "QUARANTINE"]},
        "impact_seeds": {
          "type": "array",
          "items": {"$ref": "#/$defs/impact_seed"},
          "minItems": 1
        },
        "before": {"type": "object"},
        "after": {"type": "object"},
        "affected_claims": {"$ref": "#/$defs/string_array"},
        "active_work_impact": {"$ref": "#/$defs/string_array"},
        "impact_slice": {
          "type": "array",
          "items": {"$ref": "#/$defs/impact_item"},
          "minItems": 1
        },
        "invalidated_evidence": {"$ref": "#/$defs/string_array"},
        "invalidated_receipts": {"$ref": "#/$defs/string_array"},
        "reactivation_projection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["waiting_go_ids", "active_go_ids", "unchanged_go_ids"],
          "properties": {
            "waiting_go_ids": {"$ref": "#/$defs/string_array"},
            "active_go_ids": {"$ref": "#/$defs/string_array"},
            "unchanged_go_ids": {"$ref": "#/$defs/string_array"}
          }
        },
        "rollback": {"$ref": "#/$defs/id"},
        "authority_binding_ref": {"$ref": "#/$defs/id"},
        "issued_at": {"$ref": "#/$defs/id"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "impact_seeds": {
                "contains": {
                  "type": "object",
                  "properties": {
                    "kind": {"enum": ["CANDIDATE", "CLAIM_OR_OUTPUT"]}
                  },
                  "required": ["kind"]
                }
              }
            },
            "required": ["impact_seeds"]
          },
          "then": {
            "properties": {
              "source_disposition": {"enum": ["REWORK", "QUARANTINE"]}
            }
          }
        }
      ]
    },
    "formal_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "resolution_id", "go_id", "kind", "amendment_id", "releases_successors", "removes_required", "authority_binding_ref", "evidence", "issued_at"],
      "properties": {
        "schema_version": {"const": "2.4.0"},
        "resolution_id": {"$ref": "#/$defs/id"},
        "go_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["SUPERSEDED", "CANCELLED"]},
        "amendment_id": {"$ref": "#/$defs/id"},
        "releases_successors": {"type": "boolean"},
        "removes_required": {"type": "boolean"},
        "authority_binding_ref": {"$ref": "#/$defs/id"},
        "evidence": {"$ref": "#/$defs/string_array"},
        "issued_at": {"$ref": "#/$defs/id"}
      }
    },
    "owner_acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "candidate_id", "candidate_sha256", "entry_points", "roles", "steps", "expected_visible_outcomes", "known_limitations", "d3_covered_invisible_risks", "owner_binding_ref", "owner_verdict", "issued_at"],
      "properties": {
        "schema_version": {"const": "2.4.0"},
        "run_id": {"$ref": "#/$defs/id"},
        "candidate_id": {"$ref": "#/$defs/id"},
        "candidate_sha256": {"$ref": "#/$defs/hash"},
        "entry_points": {"$ref": "#/$defs/string_array"},
        "roles": {"$ref": "#/$defs/string_array"},
        "steps": {"$ref": "#/$defs/string_array"},
        "expected_visible_outcomes": {"$ref": "#/$defs/string_array"},
        "known_limitations": {"$ref": "#/$defs/string_array"},
        "d3_covered_invisible_risks": {"$ref": "#/$defs/string_array"},
        "owner_binding_ref": {"$ref": "#/$defs/id"},
        "owner_verdict": {"enum": ["PENDING", "LOOP_OWNER_ACCEPTED", "LOOP_PRODUCT_REWORK", "PRODUCT_DEFINITION_CHANGE", "NEW_FEATURE_REQUEST"]},
        "issued_at": {"$ref": "#/$defs/id"}
      }
    },
    "security_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "candidate_id", "candidate_sha256", "scope", "required_auditor_binding", "status", "post_security_acceptance_requirement", "issued_at"],
      "properties": {
        "schema_version": {"const": "2.4.0"},
        "run_id": {"$ref": "#/$defs/id"},
        "candidate_id": {"$ref": "#/$defs/id"},
        "candidate_sha256": {"$ref": "#/$defs/hash"},
        "scope": {"$ref": "#/$defs/string_array"},
        "required_auditor_binding": {"$ref": "#/$defs/id"},
        "status": {"enum": ["PENDING_LCCODING_AUDIT", "ACCEPTED_BY_LCCODING"]},
        "post_security_acceptance_requirement": {"const": true},
        "issued_at": {"$ref": "#/$defs/id"}
      }
    }
  }
}
